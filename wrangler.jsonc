{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "split-decision-remote",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "vars": {
    "FRONTEND_ORIGIN": "https://splitdecision.planitnow.us"
  },
  "routes": [
    {
      "pattern": "splitdecision-api.planitnow.us",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
